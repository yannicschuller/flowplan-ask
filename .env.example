# Public https address of this service (e.g. https://ask.flowplan.org).
ASK_URL=
# Claude API key (console.anthropic.com → API keys). Set a monthly spend limit
# in the Anthropic console as well. Never commit it.
ANTHROPIC_API_KEY=
# Bearer token for flowplan-admin (at least 24 characters, e.g. `openssl rand -hex 32`).
# Unset: the admin API answers 404.
ASK_ADMIN_TOKEN=
# Bearer token of the Discord bot (at least 24 characters, not the admin token).
# Unset: no Discord questions.
ASK_BOT_TOKEN=
# HMAC key for hashed addresses, subjects, session tokens and proof-of-work
# challenges (`openssl rand -hex 32`). Unset: generated once into the data directory.
ASK_SECRET=
# The public docs (default https://docs.flowplan.org).
DOCS_URL=
# Origins allowed to call the public API from a browser, comma-separated
# (default https://docs.flowplan.org).
ASK_ALLOWED_ORIGINS=
# The status data of Flowplan's hosted services when the settings leave the
# addresses empty (defaults: flowplan-status's summary.json and
# https://status.flowplan.org/services.json).
STATUS_SUMMARY_URL=
STATUS_SERVICES_URL=
# Where the SQLite database lives (the Docker image uses /app/data).
ASK_DATA_DIR=
# Port of the server (default 3000).
PORT=
